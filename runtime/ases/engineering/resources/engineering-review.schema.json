{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ases:engineering-review:1.1",
  "type":"object",
  "required":["schema","operations"],
  "properties":{
    "schema":{"enum":["ases-engineering-review/1.0","ases-engineering-review/1.1"]},
    "base_model_digest":{"type":"string","minLength":1},
    "operations":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/operation"}}
  },
  "allOf":[
    {"if":{"properties":{"schema":{"const":"ases-engineering-review/1.1"}}},"then":{"required":["base_model_digest"]}},
    {"if":{"properties":{"schema":{"const":"ases-engineering-review/1.0"}}},"then":{"properties":{"operations":{"items":{"properties":{"action":{"enum":["annotate","confirm","reject"]}}}}}}}
  ],
  "$defs":{
    "operation":{
      "type":"object","required":["action","record_id"],
      "properties":{
        "action":{"enum":["annotate","confirm","reject","set-operation-context","add-requirement","adopt-requirement"]},
        "record_id":{"type":"string","minLength":1},
        "expected_digest":{"type":"string","minLength":1},
        "base_model_digest":{"type":"string","minLength":1},
        "note":{"type":"string","maxLength":10000},
        "source_record_id":{"type":"string","minLength":1},
        "expected_source_digest":{"type":"string","minLength":1},
        "context":{"type":"object","additionalProperties":false,"properties":{
          "title":{"type":"string","maxLength":200},"actor":{"type":"string","maxLength":1000},
          "purpose":{"type":"string","maxLength":4000},"acceptance":{"type":"string","maxLength":4000}}},
        "requirement":{"$ref":"#/$defs/requirement"}
      },
      "allOf":[
        {"if":{"properties":{"action":{"enum":["annotate","confirm","reject"]}}},"then":{"required":["note","expected_digest"]}},
        {"if":{"properties":{"action":{"const":"set-operation-context"}}},"then":{"required":["context","expected_digest"]}},
        {"if":{"properties":{"action":{"enum":["add-requirement","adopt-requirement"]}}},"then":{"required":["requirement"],"properties":{"record_id":{"pattern":"^user-requirement:[A-Za-z0-9._:-]{1,120}$"}}}},
        {"if":{"properties":{"action":{"const":"adopt-requirement"}}},"then":{"required":["source_record_id","expected_source_digest"]}}
      ]
    },
    "requirement":{
      "type":"object","required":["declared_id","kind","statement","author","scope","acceptance"],
      "properties":{
        "declared_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"},
        "kind":{"enum":["functional","nonfunctional"]},
        "statement":{"type":"string","pattern":"\\S","maxLength":8000},
        "author":{"type":"string","pattern":"\\S","maxLength":200},
        "scope":{"type":"string","pattern":"\\S","maxLength":1000},
        "acceptance":{"type":"string","pattern":"\\S","maxLength":4000}
      }
    }
  }
}
